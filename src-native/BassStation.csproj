<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>BassStation.ico</ApplicationIcon>
    <AssemblyName>BassStation</AssemblyName>
    <RootNamespace>BassStation</RootNamespace>
    <ApplicationTitle>BaSSDream</ApplicationTitle>
    <Product>BaSSDream</Product>
    <Company>BassStation Studio</Company>
    <Version>2.0.0</Version>
    <FileVersion>2.0.0.0</FileVersion>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="BassStation.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Resource Include="assets\**\*" Exclude="assets\boot\splash.png" />
    <!-- first frame of the boot animation, shown natively before .NET starts -->
    <SplashScreen Include="assets\boot\splash.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

</Project>
