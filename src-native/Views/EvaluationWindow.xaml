<Window x:Class="BassStation.Views.EvaluationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="演奏评测"
        Width="820" Height="660"
        WindowStartupLocation="CenterOwner"
        Background="#FAF7F9"
        UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <Style x:Key="DimLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#5A5566" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="DimValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontFamily" Value="{StaticResource NumFont}" />
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="DimBar" TargetType="ProgressBar">
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Background" Value="#F7F1F4" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="JudgeName" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontFamily" Value="{StaticResource NumFont}" />
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="JudgeCount" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontFamily" Value="{StaticResource NumFont}" />
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Text" Value="--" />
        </Style>
        <Style x:Key="TakeRow" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource WashBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Header Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                <Path Data="{StaticResource ExclaimBoltGeometry}" Fill="{StaticResource HardBrush}" Stretch="Uniform" Width="14" Height="27" Margin="0,0,10,4" />
                <StackPanel>
                    <TextBlock Text="演奏评测" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                    <Border Height="3" Background="{StaticResource BrandBrush}" Width="320" HorizontalAlignment="Left" Margin="0,3,0,0" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- 2. Target Song Banner -->
        <Border Grid.Row="1" Background="{StaticResource WhiteBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="6" Background="{StaticResource LineBrush}" ClipToBounds="True">
                    <Image x:Name="imgSongCover" Stretch="UniformToFill" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                    <TextBlock x:Name="txtSongTitle" FontSize="14" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                    <TextBlock FontSize="11.5" Foreground="{StaticResource SubBrush}" Margin="0,2,0,0">
                        <Run x:Name="txtSongArtist" />
                        <Run Text=" · " />
                        <Run x:Name="txtSongBpm" />
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Border x:Name="bdTier" Background="#FAF5FF" CornerRadius="6" Padding="8,2" HorizontalAlignment="Right">
                        <TextBlock x:Name="txtTier" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource NumFont}" FontStyle="Italic" Foreground="{StaticResource SpecialBrush}" />
                    </Border>
                    <TextBlock x:Name="txtLevel" FontSize="14" FontWeight="Bold" FontFamily="{StaticResource NumFont}" FontStyle="Italic" Foreground="{StaticResource SpecialBrush}" HorizontalAlignment="Right" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Result -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Rank & Score -->
            <Border Grid.Column="0" Background="{StaticResource WhiteBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="20">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border x:Name="bdRankCircle" Width="100" Height="100" CornerRadius="6" BorderThickness="3" HorizontalAlignment="Center">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="txtRankLabel" Text="RANK" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource NumFont}" FontStyle="Italic" HorizontalAlignment="Center" />
                            <TextBlock x:Name="txtRankGrade" Text="--" FontSize="44" FontWeight="Bold" FontFamily="{StaticResource NumFont}" FontStyle="Italic" HorizontalAlignment="Center" Margin="0,-4,0,0" />
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                        <TextBlock x:Name="txtOverallScore" Text="--" FontSize="36" FontWeight="Bold" FontFamily="{StaticResource NumFont}" FontStyle="Italic" Foreground="{StaticResource InkBrush}" />
                    </StackPanel>

                    <Border x:Name="bdCombo" Background="{StaticResource WashBrush}" CornerRadius="6" Padding="12,4" Margin="0,10,0,0" HorizontalAlignment="Center" Visibility="Collapsed">
                        <TextBlock x:Name="txtComboBadge" FontSize="12" FontWeight="Bold" FontFamily="{StaticResource NumFont}" FontStyle="Italic" Foreground="{StaticResource BrandBrush}" />
                    </Border>

                    <Border x:Name="bdNewBest" Background="{StaticResource HardBrush}" CornerRadius="3" Padding="6,1" Margin="0,8,0,0" HorizontalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="NEW BEST" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource NumFont}" FontStyle="Italic" Foreground="{StaticResource WhiteBrush}" />
                    </Border>

                    <TextBlock x:Name="txtEvaluatedAt" FontSize="11" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <!-- Right: judgments, dimensions, measures, comment -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Judgments + measure strip -->
                <Border Grid.Row="0" Background="{StaticResource WhiteBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1.3*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="PERFECT" Foreground="{StaticResource BrandBrush}" Style="{StaticResource JudgeName}" />
                                <TextBlock x:Name="txtPerfect" Style="{StaticResource JudgeCount}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="GREAT" Foreground="{StaticResource HardBrush}" Style="{StaticResource JudgeName}" />
                                <TextBlock x:Name="txtGreat" Style="{StaticResource JudgeCount}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="GOOD" Foreground="{StaticResource NormalBrush}" Style="{StaticResource JudgeName}" />
                                <TextBlock x:Name="txtGood" Style="{StaticResource JudgeCount}" />
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="BAD" Foreground="{StaticResource EasyBrush}" Style="{StaticResource JudgeName}" />
                                <TextBlock x:Name="txtBad" Style="{StaticResource JudgeCount}" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="MISS" Foreground="#9A93A6" Style="{StaticResource JudgeName}" />
                                <TextBlock x:Name="txtMiss" Style="{StaticResource JudgeCount}" />
                            </StackPanel>
                            <Border Grid.Column="5" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="MAX COMBO" Foreground="{StaticResource SubBrush}" Style="{StaticResource JudgeName}" />
                                    <TextBlock x:Name="txtMaxCombo" Style="{StaticResource JudgeCount}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <ItemsControl x:Name="icMeasures" Margin="0,12,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="7" Height="16" Margin="0,0,2,2" CornerRadius="1.5" Background="{Binding Color}" ToolTip="{Binding Tip}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Dimensions -->
                <Border Grid.Row="1" Background="{StaticResource WhiteBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="22" />
                            <RowDefinition Height="22" />
                            <RowDefinition Height="22" />
                            <RowDefinition Height="22" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="节奏" Style="{StaticResource DimLabel}" />
                        <ProgressBar Grid.Row="0" Grid.Column="1" x:Name="pbTiming" Foreground="{StaticResource BrandBrush}" Style="{StaticResource DimBar}" />
                        <TextBlock Grid.Row="0" Grid.Column="2" x:Name="txtTiming" Style="{StaticResource DimValue}" />
                        <TextBlock Grid.Row="1" Text="音准" Style="{StaticResource DimLabel}" />
                        <ProgressBar Grid.Row="1" Grid.Column="1" x:Name="pbPitch" Foreground="{StaticResource HardBrush}" Style="{StaticResource DimBar}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" x:Name="txtPitch" Style="{StaticResource DimValue}" />
                        <TextBlock Grid.Row="2" Text="完整" Style="{StaticResource DimLabel}" />
                        <ProgressBar Grid.Row="2" Grid.Column="1" x:Name="pbComplete" Foreground="{StaticResource NormalBrush}" Style="{StaticResource DimBar}" />
                        <TextBlock Grid.Row="2" Grid.Column="2" x:Name="txtComplete" Style="{StaticResource DimValue}" />
                        <TextBlock Grid.Row="3" Text="干净" Style="{StaticResource DimLabel}" />
                        <ProgressBar Grid.Row="3" Grid.Column="1" x:Name="pbClean" Foreground="{StaticResource EasyBrush}" Style="{StaticResource DimBar}" />
                        <TextBlock Grid.Row="3" Grid.Column="2" x:Name="txtClean" Style="{StaticResource DimValue}" />
                    </Grid>
                </Border>

                <!-- Take history: a row opens that take's result screen -->
                <Border Grid.Row="2" x:Name="cardHistory" Background="{StaticResource WhiteBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="6,6" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="icTakes">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Click="TakeRow_Click" Tag="{Binding}" Cursor="Hand" Opacity="{Binding RowOpacity}"
                                            IsEnabled="{Binding HasReport}" Style="{StaticResource TakeRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="88" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="34" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding When}" FontSize="11" Foreground="#9A93A6" FontFamily="{StaticResource NumFont}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding ChartText}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{Binding PointsText}" FontSize="13" FontWeight="Bold" FontFamily="{StaticResource NumFont}" FontStyle="Italic" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding Grade}" FontSize="13" FontWeight="Bold" FontFamily="{StaticResource NumFont}" FontStyle="Italic" Foreground="{Binding GradeColor}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- 4. Action -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="1.3*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" x:Name="btnUploadAudio" Click="BtnUploadAudio_Click" Height="54" Style="{StaticResource GbpButtonWhite}" HorizontalAlignment="Stretch">
                <StackPanel Orientation="Horizontal">
                    <Path x:Name="icoUpload" Data="M 2,3 L 6,3 L 8,5 L 14,5 C 14.5,5 15,5.5 15,6 L 15,12 C 15,12.5 14.5,13 14,13 L 2,13 C 1.5,13 1,12.5 1,12 L 1,4 C 1,3.5 1.5,3 2,3 Z" Stroke="{StaticResource TextBrush}" StrokeThickness="1.6" Width="15" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock x:Name="txtUpload" Text="选择录音" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <!-- input device -->
            <Button Grid.Column="2" x:Name="btnInput" Click="BtnInput_Click" Height="54" Width="120" Style="{StaticResource GbpButtonWhite}" Padding="12,6">
                <StackPanel Orientation="Horizontal">
                    <Path Data="M 6,1 C 7.7,1 9,2.3 9,4 L 9,8 C 9,9.7 7.7,11 6,11 C 4.3,11 3,9.7 3,8 L 3,4 C 3,2.3 4.3,1 6,1 Z M 1,7.5 C 1,10.5 3.2,12.6 6,12.6 C 8.8,12.6 11,10.5 11,7.5 M 6,12.6 L 6,15" Stroke="{StaticResource TextBrush}" StrokeThickness="1.5" Width="11" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock x:Name="txtInput" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="72" />
                </StackPanel>
                <Button.ContextMenu>
                    <ContextMenu x:Name="menuInput" />
                </Button.ContextMenu>
            </Button>

            <!-- practice range: whole song or one section -->
            <Button Grid.Column="4" x:Name="btnSection" Click="BtnSection_Click" Height="54" Width="118" Style="{StaticResource GbpButtonWhite}" Padding="10,6">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="txtSection" Text="全曲" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="80" />
                    <Path Data="M 0,0 L 8,0 L 4,5 Z" Fill="{StaticResource TextBrush}" Width="8" Height="5" Stretch="Uniform" VerticalAlignment="Center" Margin="7,1,0,0" />
                </StackPanel>
                <Button.ContextMenu>
                    <ContextMenu x:Name="menuSection" />
                </Button.ContextMenu>
            </Button>

            <!-- backing tempo -->
            <Button Grid.Column="6" x:Name="btnRate" Click="BtnRate_Click" Height="54" Width="84" Style="{StaticResource GbpButtonWhite}" Padding="10,6">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="txtRate" Text="100%" FontSize="13" FontWeight="Bold" FontFamily="{StaticResource NumFont}" FontStyle="Italic" VerticalAlignment="Center" />
                    <Path Data="M 0,0 L 8,0 L 4,5 Z" Fill="{StaticResource TextBrush}" Width="8" Height="5" Stretch="Uniform" VerticalAlignment="Center" Margin="7,1,0,0" />
                </StackPanel>
                <Button.ContextMenu>
                    <ContextMenu x:Name="menuRate" />
                </Button.ContextMenu>
            </Button>

            <Button Grid.Column="8" x:Name="btnRecord" Click="BtnRecord_Click" Height="54" Style="{StaticResource GbpButton}" HorizontalAlignment="Stretch">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="icoRecord" Width="12" Height="12" Fill="{StaticResource WhiteBrush}" VerticalAlignment="Center" Margin="0,0,9,0" />
                    <Rectangle x:Name="icoStop" Width="11" Height="11" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource WhiteBrush}" VerticalAlignment="Center" Margin="0,0,9,0" Visibility="Collapsed" />
                    <TextBlock x:Name="txtRecord" Text="开始录制" FontSize="14" FontWeight="Bold" Foreground="{StaticResource WhiteBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
