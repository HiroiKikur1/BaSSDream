<UserControl x:Class="BassStation.Views.ScoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:BassStation.Views"
             Focusable="True" FocusVisualStyle="{x:Null}" Background="#E7E1E6"
             FontFamily="{StaticResource UiFont}">
    <UserControl.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <FontFamily x:Key="Din">Bahnschrift</FontFamily>
        <SolidColorBrush x:Key="Chrome" Color="#1E1C22" />
        <SolidColorBrush x:Key="Chrome2" Color="#28262D" />
        <SolidColorBrush x:Key="ChromeLine" Color="#3A3741" />
        <SolidColorBrush x:Key="ChromeText" Color="#ECE8EF" />
        <SolidColorBrush x:Key="ChromeSub" Color="#9C97A4" />
        <SolidColorBrush x:Key="Accent" Color="{StaticResource BrandColor}" />

        <!-- flat tool button: icon glyph + label; Tag="on" marks a latched toggle -->
        <Style x:Key="Tool" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource ChromeText}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="latch" Height="2" VerticalAlignment="Bottom" Margin="8,0" Background="{StaticResource Accent}" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#34313B" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#43404B" />
                            </Trigger>
                            <Trigger Property="Tag" Value="on">
                                <Setter TargetName="latch" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="#FF6E9C" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Icons}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource ChromeSub}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Readout" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Din}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource ChromeText}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Sep" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="10,0" />
            <Setter Property="Background" Value="{StaticResource ChromeLine}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource Din}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource ChromeText}" />
            <Setter Property="Background" Value="#15141A" />
            <Setter Property="BorderBrush" Value="{StaticResource ChromeLine}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="#FF6E9C" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <!-- thin fader: 3px track, round thumb -->
        <Style x:Key="Fader" TargetType="Slider">
            <Setter Property="Width" Value="112" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1.2" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="18" Background="Transparent">
                            <Border Height="3" CornerRadius="1.5" Background="#44414C" VerticalAlignment="Center" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="3" CornerRadius="1.5" Background="{StaticResource Accent}" VerticalAlignment="Center" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="12" Height="12" Fill="{StaticResource WhiteBrush}" Stroke="{StaticResource Accent}" StrokeThickness="2" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <!-- toolbar -->
        <Border Grid.Row="0" Background="{StaticResource Chrome}">
            <DockPanel LastChildFill="False" Margin="8,0,12,0">
                <Button x:Name="btnBack" DockPanel.Dock="Left" Click="BtnBack_Click" Style="{StaticResource Tool}" ToolTip="返回">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE72B;" />
                </Button>
                <Border x:Name="edStripe" DockPanel.Dock="Left" Width="4" Height="30" Margin="6,0,10,0" Background="{StaticResource Accent}" VerticalAlignment="Center" />
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Width="220">
                    <TextBlock x:Name="txtTitle" FontFamily="{x:Static v:ScoreCanvas.Round}" FontWeight="Black" FontSize="15" Foreground="{StaticResource ChromeText}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="txtArtist" FontSize="11" Foreground="{StaticResource ChromeSub}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Border DockPanel.Dock="Left" Style="{StaticResource Sep}" />

                <!-- transport -->
                <Button x:Name="btnHome" DockPanel.Dock="Left" Click="BtnHome_Click" Style="{StaticResource Tool}" ToolTip="回到开头">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE892;" />
                </Button>
                <Button x:Name="btnPlay" DockPanel.Dock="Left" Click="BtnPlay_Click" Style="{StaticResource Tool}" Width="40">
                    <TextBlock x:Name="icoPlay" Style="{StaticResource Glyph}" FontSize="16" Text="&#xE768;" />
                </Button>
                <TextBlock x:Name="txtTime" DockPanel.Dock="Left" Style="{StaticResource Readout}" FontSize="16" Width="118" Margin="8,0,0,0" Text="0:00.0 / 0:00" />
                <Border DockPanel.Dock="Left" Style="{StaticResource Sep}" />

                <!-- tempo: percentage presets and a BPM field -->
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Label}" Text="速度" Margin="0,0,6,0" />
                <Button x:Name="btnSlower" DockPanel.Dock="Left" Click="BtnSlower_Click" Style="{StaticResource Tool}" Padding="6,0">
                    <TextBlock Style="{StaticResource Glyph}" FontSize="11" Text="&#xE738;" />
                </Button>
                <Button x:Name="btnRate" DockPanel.Dock="Left" Click="BtnRate_Click" Style="{StaticResource Tool}" Width="58">
                    <TextBlock x:Name="txtRate" Style="{StaticResource Readout}" Text="100%" />
                    <Button.ContextMenu>
                        <ContextMenu x:Name="menuRate" />
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="btnFaster" DockPanel.Dock="Left" Click="BtnFaster_Click" Style="{StaticResource Tool}" Padding="6,0">
                    <TextBlock Style="{StaticResource Glyph}" FontSize="11" Text="&#xE710;" />
                </Button>
                <TextBox x:Name="txtBpm" DockPanel.Dock="Left" Style="{StaticResource Field}" Width="56" Margin="8,0,4,0" KeyDown="TxtBpm_KeyDown" LostKeyboardFocus="TxtBpm_LostFocus" />
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Label}" Text="BPM" />
                <Border DockPanel.Dock="Left" Style="{StaticResource Sep}" />

                <!-- loop: the selected bars (Shift+click) or the section around the cursor -->
                <Button x:Name="btnLoop" DockPanel.Dock="Left" Click="BtnLoop_Click" Style="{StaticResource Tool}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8EE;" />
                        <TextBlock x:Name="txtLoop" Margin="7,0,0,0" FontFamily="{StaticResource Din}" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center" Text="循环" />
                    </StackPanel>
                </Button>
                <Border DockPanel.Dock="Left" Style="{StaticResource Sep}" />

                <!-- backing alignment -->
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Label}" Text="对齐" Margin="0,0,6,0" />
                <Button x:Name="btnEarlier" DockPanel.Dock="Left" Click="BtnEarlier_Click" Style="{StaticResource Tool}" Padding="6,0" ToolTip="伴奏提前">
                    <TextBlock Style="{StaticResource Glyph}" FontSize="11" Text="&#xE738;" />
                </Button>
                <TextBox x:Name="txtOffset" DockPanel.Dock="Left" Style="{StaticResource Field}" Width="72" KeyDown="TxtOffset_KeyDown" LostKeyboardFocus="TxtOffset_LostFocus" />
                <Button x:Name="btnLater" DockPanel.Dock="Left" Click="BtnLater_Click" Style="{StaticResource Tool}" Padding="6,0" ToolTip="伴奏推后">
                    <TextBlock Style="{StaticResource Glyph}" FontSize="11" Text="&#xE710;" />
                </Button>
                <Button x:Name="btnAutoAlign" DockPanel.Dock="Left" Click="BtnAutoAlign_Click" Style="{StaticResource Tool}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE895;" />
                        <TextBlock x:Name="txtAuto" Margin="7,0,0,0" VerticalAlignment="Center" Text="自动" />
                    </StackPanel>
                </Button>

            </DockPanel>
        </Border>

        <!-- mixer + view options -->
        <Border Grid.Row="1" Background="{StaticResource Chrome2}" BorderBrush="{StaticResource ChromeLine}" BorderThickness="0,1,0,1">
            <DockPanel LastChildFill="False" Margin="20,0">
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Label}" Text="伴奏" Margin="0,0,10,0" />
                <Slider x:Name="volBacking" DockPanel.Dock="Left" Style="{StaticResource Fader}" ValueChanged="Volume_Changed" Tag="0" />
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Label}" Text="原贝斯" Margin="26,0,10,0" />
                <Slider x:Name="volBass" DockPanel.Dock="Left" Style="{StaticResource Fader}" ValueChanged="Volume_Changed" Tag="1" />
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Label}" Text="谱面" Margin="26,0,10,0" />
                <Slider x:Name="volSynth" DockPanel.Dock="Left" Style="{StaticResource Fader}" ValueChanged="Volume_Changed" Tag="2" />
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Label}" Text="节拍器" Margin="26,0,10,0" />
                <Slider x:Name="volClick" DockPanel.Dock="Left" Style="{StaticResource Fader}" ValueChanged="Volume_Changed" Tag="3" />

                <Button x:Name="btnStaff" DockPanel.Dock="Right" Click="BtnStaff_Click" Style="{StaticResource Tool}" Tag="on" Height="28">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xEC4F;" />
                        <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" Text="五线谱" />
                    </StackPanel>
                </Button>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Ellipse x:Name="edDot" Width="9" Height="9" Fill="{StaticResource Accent}" VerticalAlignment="Center" />
                    <TextBlock x:Name="txtEdition" Style="{StaticResource Label}" Margin="7,0,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- the page -->
        <ScrollViewer x:Name="scroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Focusable="False">
            <Grid x:Name="page" HorizontalAlignment="Center" Margin="0,18,0,24">
                <v:ScoreCanvas x:Name="canvas" MouseLeftButtonDown="Canvas_MouseDown" />
                <Canvas IsHitTestVisible="False">
                    <Rectangle x:Name="cursor" Width="2.5" RadiusX="1.2" RadiusY="1.2" Fill="{StaticResource BrandBrush}" Visibility="Collapsed" />
                </Canvas>
            </Grid>
        </ScrollViewer>
        <TextBlock x:Name="txtLoading" Grid.Row="2" Text="准备中" FontSize="16" FontWeight="Bold" Foreground="#9C97A4"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />

        <!-- status bar: facts only -->
        <Border Grid.Row="3" Background="{StaticResource Chrome}">
            <StackPanel Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                <TextBlock x:Name="stPos" Style="{StaticResource Readout}" FontSize="12" Width="150" />
                <TextBlock x:Name="stMeter" Style="{StaticResource Readout}" FontSize="12" Width="70" />
                <TextBlock x:Name="stKey" Style="{StaticResource Readout}" FontSize="12" FontFamily="{StaticResource UiFont}" Width="90" />
                <TextBlock x:Name="stTempo" Style="{StaticResource Readout}" FontSize="12" Width="170" />
                <TextBlock x:Name="stAlign" Style="{StaticResource Readout}" FontSize="12" Width="130" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
