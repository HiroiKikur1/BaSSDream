<Window x:Class="BassStation.Views.AddSongWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加曲目"
        Width="780" Height="540" MinWidth="680" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="#FAF7F9"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="{StaticResource UiFont}"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">


    <Grid Margin="24">
        <Grid.Resources>
        <LinearGradientBrush x:Key="PinkVividGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FF3377" Offset="0.0" />
            <GradientStop Color="#F21D68" Offset="1.0" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PurpleGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#E04BD6" Offset="0.0" />
            <GradientStop Color="#C43ABB" Offset="1.0" />
        </LinearGradientBrush>
    </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Path Data="{StaticResource ExclaimBoltGeometry}" Fill="#FFAE1A" Stretch="Uniform" Width="14" Height="27"  Margin="0,0,10,4" />
                    <StackPanel>
                        <TextBlock Text="添加曲目" FontSize="22" FontWeight="Bold" Foreground="#4A4750" />
                        <Border Height="3" Background="#FF3B72" Width="320" HorizontalAlignment="Left" Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>
        </Grid>

        <!-- 2. Search Input -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="100" />
            </Grid.ColumnDefinitions>

            <Border Background="#FFFFFF" BorderBrush="#F0CFDD" BorderThickness="1.5" CornerRadius="6" Height="44" Padding="14,0">
                <Grid VerticalAlignment="Center">
                    <TextBox x:Name="txtQuery" BorderThickness="0" Background="Transparent" FontSize="14" KeyDown="TxtQuery_KeyDown" TextChanged="TxtQuery_TextChanged" VerticalAlignment="Center" Foreground="#3D3A4B" />
                    <TextBlock x:Name="txtPlaceholder" Text="搜索" Foreground="#B3ACBC" FontSize="14" IsHitTestVisible="False" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Button Grid.Column="2" x:Name="btnSearch" Click="BtnSearch_Click" Content="搜索" Height="48" FontWeight="Bold" FontSize="14" Style="{StaticResource GbpButton}">
                
            </Button>
        </Grid>

        <!-- 3. Results Container -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#F1DCE5" BorderThickness="1" CornerRadius="6" Padding="16">
            <Grid>
                <!-- Empty State / File Drop Area -->
                <StackPanel x:Name="pnlEmptyState" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Path Data="M 15.5,14 H 14.7 L 14.4,13.7 C 15.4,12.5 16,11 16,9.5 C 16,5.9 13.1,3 9.5,3 C 5.9,3 3,5.9 3,9.5 C 3,13.1 5.9,16 9.5,16 C 11,16 12.5,15.4 13.7,14.4 L 14,14.7 V 15.5 L 19,20.5 L 20.5,19 L 15.5,14 Z M 9.5,14 C 7,14 5,12 5,9.5 C 5,7 7,5 9.5,5 C 12,5 14,7 14,9.5 C 14,12 12,14 9.5,14 Z"
                          Fill="#F0CFDD" Width="36" Height="36" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <Button x:Name="btnBrowseLocal" Click="BtnBrowseLocal_Click" Cursor="Hand" Background="#F7F1F4" BorderBrush="#F0CFDD" BorderThickness="1" Padding="16,8" HorizontalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="M 2,3 L 6,3 L 8,5 L 14,5 C 14.5,5 15,5.5 15,6 L 15,12 C 15,12.5 14.5,13 14,13 L 2,13 C 1.5,13 1,12.5 1,12 L 1,4 C 1,3.5 1.5,3 2,3 Z" Stroke="#7C7688" StrokeThickness="1.5" Fill="Transparent" Width="14" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="选择本地文件" FontSize="12.5" FontWeight="Bold" Foreground="#5A5566" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- Loading State -->
                <StackPanel x:Name="pnlLoading" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="检索中..." FontSize="14" FontWeight="Bold" Foreground="#FF3377" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Search Results Presentation Deck -->
                <ScrollViewer x:Name="scrollResults" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel>
                        <!-- Section A: Online Tabs List -->
                        <TextBlock x:Name="lblOnlineTabs" Text="在线乐谱" FontSize="12" FontWeight="Bold" Foreground="#7C7688" Margin="0,0,0,8" />
                        <ItemsControl x:Name="icTabs">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Background="#FFF7FA" BorderBrush="#F1DCE5" BorderThickness="1" CornerRadius="6" Padding="14,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Background="#34C274" CornerRadius="3" Padding="5,1.5" Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <TextBlock Text="GP谱" FontSize="9.5" FontWeight="Bold" Foreground="#FFFFFF" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="Bold" Foreground="#3D3A4B" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding SubInfo}" FontSize="12" Foreground="#7C7688" Margin="0,3,0,0" />
                                            </StackPanel>

                                            <Button Grid.Column="1" Click="BtnImportItem_Click" Tag="{Binding}" Cursor="Hand" VerticalAlignment="Center">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{StaticResource PinkVividGradient}" CornerRadius="6" Padding="14,7">
                                                            <TextBlock Text="导入" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Section B: Audio Match / Transcribe -->
                        <TextBlock x:Name="lblAudioSources" Text="官方音源" FontSize="12" FontWeight="Bold" Foreground="#7C7688" Margin="0,10,0,8" />
                        <ItemsControl x:Name="icAudio">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Background="#FAF5FF" BorderBrush="#DDD6FE" BorderThickness="1" CornerRadius="6" Padding="14,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Background="#E04BD6" CornerRadius="3" Padding="5,1.5" Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Source}" FontSize="9.5" FontWeight="Bold" Foreground="#FFFFFF" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="Bold" Foreground="#3D3A4B" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding SubInfo}" FontSize="12" Foreground="#7C7688" Margin="0,3,0,0" />
                                            </StackPanel>

                                            <Button Grid.Column="1" Click="BtnTranscribeItem_Click" Tag="{Binding}" Cursor="Hand" VerticalAlignment="Center">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{StaticResource PurpleGradient}" CornerRadius="6" Padding="14,7">
                                                            <TextBlock Text="扒谱" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Section C: Bilibili Reference -->
                        <TextBlock x:Name="lblBiliReferences" Text="演奏参考" FontSize="12" FontWeight="Bold" Foreground="#7C7688" Margin="0,10,0,8" />
                        <ItemsControl x:Name="icBili">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6" Padding="14,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Background="#0284C7" CornerRadius="3" Padding="5,1.5" Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <TextBlock Text="B站" FontSize="9.5" FontWeight="Bold" Foreground="#FFFFFF" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" Foreground="#3D3A4B" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="540" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding SubInfo}" FontSize="12" Foreground="#7C7688" Margin="0,3,0,0" />
                                            </StackPanel>

                                            <Button Grid.Column="1" Click="BtnOpenReference_Click" Tag="{Binding}" Cursor="Hand" VerticalAlignment="Center">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="#0284C7" CornerRadius="6" Padding="14,7">
                                                            <TextBlock Text="参考" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 4. Bottom Status Strip -->
        <Border Grid.Row="3" Margin="0,12,0,0">
            <Grid>
                <TextBlock x:Name="txtStatus" Text="" FontSize="12" Foreground="#7C7688" VerticalAlignment="Center" />
                <Button x:Name="btnClose" Click="BtnClose_Click" Content="关闭" HorizontalAlignment="Right" Padding="16,5" FontWeight="Bold" FontSize="12" Style="{StaticResource GbpButtonWhite}">
                    
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>