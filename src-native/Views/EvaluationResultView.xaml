<UserControl x:Class="BassStation.Views.EvaluationResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="1440" Height="810"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Ideal">

    <UserControl.Resources>
        <!-- GBP result-screen buttons: grey hairline, white rim, flat face -->
        <Style x:Key="ResultButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#494C48" />
            <Setter Property="FontFamily" Value="{StaticResource RoundFont}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="25" />
            <Setter Property="Tag" Value="#FFF7F7F7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border CornerRadius="12" Background="#40000000" Margin="0,3,0,-3" />
                            <Border CornerRadius="12" Background="#B4B2B6" Padding="1.5">
                                <Border CornerRadius="10.5" Background="#FFFFFF" Padding="3.5">
                                    <Border x:Name="face" CornerRadius="7.5" Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2" />
                                    </Border>
                                </Border>
                            </Border>
                            <Border x:Name="dim" CornerRadius="12" Background="#000000" Opacity="0" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="dim" Property="Opacity" Value="0.04" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="dim" Property="Opacity" Value="0.12" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#F9F9F8" Offset="0" />
                        <GradientStop Color="#E9EAE8" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ResultButtonPink" TargetType="Button" BasedOn="{StaticResource ResultButton}">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FF2A82" Offset="0" />
                        <GradientStop Color="#FE006D" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Digits" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource GbpLatin}" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="Foreground" Value="#4E4E4E" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
        <Style x:Key="RoundLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource RoundFont}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="#494A47" />
        </Style>

        <DrawingBrush x:Key="DotRule" Viewport="0,0,9,3" ViewportUnits="Absolute" TileMode="Tile" Stretch="None">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="Transparent" Geometry="M0,0 H9 V3 H0 Z" />
                    <GeometryDrawing Brush="#C8C8C8" Geometry="M 0,1.5 A 1.5,1.5 0 1 1 3,1.5 A 1.5,1.5 0 1 1 0,1.5 Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <LinearGradientBrush x:Key="RowRule" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00B8BAB9" Offset="0" />
            <GradientStop Color="#B8BAB9" Offset="0.45" />
            <GradientStop Color="#B8BAB9" Offset="1" />
        </LinearGradientBrush>
    </UserControl.Resources>

    <Canvas x:Name="root" Width="1440" Height="810" ClipToBounds="True" Background="#1B1530">
        <Image Source="pack://application:,,,/assets/result_stage.jpg" Width="1440" Height="810" Stretch="UniformToFill" />

        <!-- ============ SUMMARY: cover, results, buttons ============ -->
        <Canvas x:Name="summaryPanel" Width="1440" Height="810">
            <!-- cover in place of the card illustration -->
            <Grid Canvas.Left="92" Canvas.Top="150" Width="496" Height="496">
                <Border Background="#FFFFFF" CornerRadius="4">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.45" Color="#1A0F33" />
                    </Border.Effect>
                </Border>
                <Border Margin="6" ClipToBounds="True" Background="#E7E1EE">
                    <Grid>
                        <TextBlock x:Name="txtCoverInitial" FontFamily="{StaticResource RoundFont}" FontWeight="Heavy" FontSize="170" Foreground="#FFFFFF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image x:Name="imgCover" Stretch="UniformToFill" />
                    </Grid>
                </Border>
            </Grid>
            <!-- line-art stars drifting beside the illustration -->
            <Canvas x:Name="decoLayer" IsHitTestVisible="False" />

            <!-- results card -->
            <Canvas x:Name="cardResult" Canvas.Left="744" Canvas.Top="232" Width="590" Height="302">
                <Border Width="590" Height="302" Background="#FFFFFF" CornerRadius="14">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.3" Color="#1A0F33" />
                    </Border.Effect>
                </Border>

                <Grid Canvas.Left="22" Canvas.Top="18" Width="30" Height="30">
                    <Ellipse Fill="#FFFFFF" Stroke="#4F504D" StrokeThickness="2.4" />
                    <Path Data="{StaticResource StarGeometry}" Fill="#4F504D" Stretch="Uniform" Width="16" Height="15" Margin="0,0,0,1" />
                </Grid>
                <TextBlock Canvas.Left="62" Canvas.Top="12" Text="得分" FontSize="26" Style="{StaticResource RoundLabel}" />
                <TextBlock x:Name="txtScore" Canvas.Left="262" Canvas.Top="13" Width="300" Style="{StaticResource Digits}" FontSize="35" Foreground="#E41E61" />
                <TextBlock Canvas.Left="62" Canvas.Top="52" Text="最高分" FontSize="22" Style="{StaticResource RoundLabel}" Foreground="#4D4D4B" />
                <TextBlock x:Name="txtBest" Canvas.Left="262" Canvas.Top="51" Width="300" Style="{StaticResource Digits}" FontSize="25" Foreground="#DB386D" />
                <Rectangle Canvas.Left="34" Canvas.Top="92" Width="530" Height="3" Fill="{StaticResource DotRule}" />

                <!-- judgments -->
                <Canvas x:Name="judgeLayer" />
                <TextBlock x:Name="nPerfect" Canvas.Left="172" Canvas.Top="106" Width="120" Style="{StaticResource Digits}" />
                <TextBlock x:Name="nGreat" Canvas.Left="172" Canvas.Top="143.5" Width="120" Style="{StaticResource Digits}" />
                <TextBlock x:Name="nGood" Canvas.Left="172" Canvas.Top="181" Width="120" Style="{StaticResource Digits}" />
                <TextBlock x:Name="nBad" Canvas.Left="172" Canvas.Top="218.5" Width="120" Style="{StaticResource Digits}" />
                <TextBlock x:Name="nMiss" Canvas.Left="172" Canvas.Top="256" Width="120" Style="{StaticResource Digits}" />
                <Rectangle Canvas.Left="120" Canvas.Top="137" Width="174" Height="1.5" Fill="{StaticResource RowRule}" />
                <Rectangle Canvas.Left="120" Canvas.Top="174.5" Width="174" Height="1.5" Fill="{StaticResource RowRule}" />
                <Rectangle Canvas.Left="120" Canvas.Top="212" Width="174" Height="1.5" Fill="{StaticResource RowRule}" />
                <Rectangle Canvas.Left="120" Canvas.Top="249.5" Width="174" Height="1.5" Fill="{StaticResource RowRule}" />

                <!-- FAST / SLOW -->
                <Border Canvas.Left="334" Canvas.Top="110" Width="132" Height="24" CornerRadius="12">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#3DC2FF" Offset="0" />
                            <GradientStop Color="#0096F5" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="FAST" FontFamily="{StaticResource RoundFont}" FontWeight="Heavy" FontSize="17" Foreground="#FFFFFF"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1" />
                </Border>
                <TextBlock x:Name="nFast" Canvas.Left="442" Canvas.Top="106" Width="120" Style="{StaticResource Digits}" />
                <Border Canvas.Left="334" Canvas.Top="148" Width="132" Height="24" CornerRadius="12">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FF8438" Offset="0" />
                            <GradientStop Color="#FD5700" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="SLOW" FontFamily="{StaticResource RoundFont}" FontWeight="Heavy" FontSize="17" Foreground="#FFFFFF"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1" />
                </Border>
                <TextBlock x:Name="nSlow" Canvas.Left="442" Canvas.Top="143.5" Width="120" Style="{StaticResource Digits}" />

                <!-- MAX COMBO -->
                <Border Canvas.Left="368" Canvas.Top="184" Width="156" Height="64" CornerRadius="6" BorderBrush="#828282" BorderThickness="1.6" Background="#FFFFFF">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="21" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Background="#3A3A3A" CornerRadius="4.5,4.5,0,0">
                            <TextBlock Text="MAX COMBO" FontFamily="{StaticResource RoundFont}" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Row="1" x:Name="nCombo" FontFamily="{StaticResource GbpLatin}" FontSize="25" Foreground="#4E4E4E"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1" />
                    </Grid>
                </Border>
                <Grid x:Name="clearHost" Canvas.Left="316" Canvas.Top="250" Width="262" Height="44" />
                <Grid x:Name="newRecordHost" Canvas.Left="276" Canvas.Top="-35" Width="306" Height="44" />
            </Canvas>

            <!-- analysis card (in place of the leaderboard) -->
            <Canvas Canvas.Left="744" Canvas.Top="546" Width="590" Height="86">
                <Border Width="590" Height="86" Background="#FFFFFF" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.3" Color="#1A0F33" />
                    </Border.Effect>
                </Border>
                <Border Canvas.Left="12" Canvas.Top="9" Width="262" Height="28" CornerRadius="14" Background="#40423F">
                    <TextBlock Text="演奏分析" FontSize="17" Style="{StaticResource RoundLabel}" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="18,0,0,1" />
                </Border>
                <TextBlock Canvas.Left="334" Canvas.Top="10" Text="错音" FontSize="20" Style="{StaticResource RoundLabel}" Foreground="#3F403B" />
                <TextBlock x:Name="nWrong" Canvas.Left="420" Canvas.Top="11" Width="110" Style="{StaticResource Digits}" FontSize="21" Foreground="#494949" />
                <Rectangle Canvas.Left="326" Canvas.Top="44" Width="250" Height="3" Fill="{StaticResource DotRule}" />
                <TextBlock Canvas.Left="44" Canvas.Top="51" Text="漏音" FontSize="20" Style="{StaticResource RoundLabel}" Foreground="#3F403B" />
                <TextBlock x:Name="nMissNote" Canvas.Left="130" Canvas.Top="52" Style="{StaticResource Digits}" FontSize="21" Foreground="#494949" TextAlignment="Left" />
                <TextBlock Canvas.Left="334" Canvas.Top="51" Text="杂音" FontSize="20" Style="{StaticResource RoundLabel}" Foreground="#3F403B" />
                <TextBlock x:Name="nExtra" Canvas.Left="420" Canvas.Top="52" Width="110" Style="{StaticResource Digits}" FontSize="21" Foreground="#494949" />
            </Canvas>

            <Button Canvas.Left="894" Canvas.Top="650" Width="172" Height="64" Style="{StaticResource ResultButton}" Content="返回" Click="BtnHome_Click" />
            <Button Canvas.Left="1084" Canvas.Top="650" Width="250" Height="64" Style="{StaticResource ResultButtonPink}" Content="详细报告" Click="BtnReport_Click" />
        </Canvas>

        <!-- ============ REPORT ============ -->
        <Canvas x:Name="reportPanel" Width="1440" Height="810" Visibility="Collapsed">
            <Border Canvas.Left="100" Canvas.Top="136" Width="1234" Height="500" Background="#F4F5F7" BorderBrush="#2B2A33" BorderThickness="2">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.4" Color="#0A0615" />
                </Border.Effect>
                <ScrollViewer x:Name="reportScroll" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False" PanningMode="VerticalOnly">
                    <ContentControl x:Name="reportHost" HorizontalAlignment="Center" />
                </ScrollViewer>
            </Border>

            <!-- bar replay: appears once a bar is picked in the report -->
            <Border x:Name="replayBar" Canvas.Left="100" Canvas.Top="650" Width="770" Height="64" Background="#1E1C22" CornerRadius="6" Visibility="Collapsed">
                <Border.Resources>
                    <Style x:Key="ReplayBtn" TargetType="Button">
                        <Setter Property="Foreground" Value="#ECE8EF" />
                        <Setter Property="FontSize" Value="14" />
                        <Setter Property="Height" Value="40" />
                        <Setter Property="Padding" Value="14,0" />
                        <Setter Property="Margin" Value="4,0" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="#2C2A32" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#3A3741" />
                                        </Trigger>
                                        <Trigger Property="Tag" Value="on">
                                            <Setter TargetName="bd" Property="Background" Value="#FF3377" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.45" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Border.Resources>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0">
                    <TextBlock x:Name="txtReplayBar" FontFamily="Bahnschrift" FontWeight="SemiBold" FontSize="16" Foreground="#ECE8EF" VerticalAlignment="Center" Width="118" />
                    <Button x:Name="btnMine" Style="{StaticResource ReplayBtn}" Click="BtnMine_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE720;" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="我的演奏" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="btnOrig" Style="{StaticResource ReplayBtn}" Click="BtnOrig_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8D6;" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="原曲贝斯" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="btnAB" Style="{StaticResource ReplayBtn}" Click="BtnAB_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8AB;" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="交替对比" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="btnStopReplay" Style="{StaticResource ReplayBtn}" Click="BtnStopReplay_Click" Padding="12,0">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE71A;" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Border>

            <Button Canvas.Left="894" Canvas.Top="650" Width="172" Height="64" Style="{StaticResource ResultButton}" Content="复制报告" FontSize="22" Click="BtnCopy_Click" />
            <Button Canvas.Left="1084" Canvas.Top="650" Width="250" Height="64" Style="{StaticResource ResultButtonPink}" Content="返回" Click="BtnReportBack_Click" />
        </Canvas>

        <!-- ============ TOP: title bar + score rank ============ -->
        <Border Canvas.Left="100" Canvas.Top="74" Width="1106" Height="46" Background="#FFFFFF" CornerRadius="11">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="1.5" Opacity="0.28" Color="#1A0F33" />
            </Border.Effect>
            <Grid Margin="12,0,22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Path Data="{StaticResource StarGeometry}" Width="30" Height="29" Stretch="Uniform" Stroke="#FFFFFF" StrokeThickness="1.6"
                      StrokeLineJoin="Round" VerticalAlignment="Center" Margin="0,0,0,1">
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FF9BD2" Offset="0" />
                            <GradientStop Color="#FF3FA3" Offset="1" />
                        </LinearGradientBrush>
                    </Path.Fill>
                    <Path.Effect>
                        <DropShadowEffect Color="#FF3FA3" BlurRadius="9" ShadowDepth="0" Opacity="0.85" />
                    </Path.Effect>
                </Path>
                <Border Grid.Column="1" x:Name="bdTier" Margin="12,0,0,0" Height="25" Padding="7,0" CornerRadius="3" VerticalAlignment="Center">
                    <TextBlock x:Name="txtTier" FontFamily="{StaticResource GbpLatin}" FontWeight="Bold" FontSize="17" Foreground="#FFFFFF" VerticalAlignment="Center" />
                </Border>
                <TextBlock Grid.Column="2" x:Name="txtTitle" FontFamily="{StaticResource GbpLatin}" FontSize="24" Foreground="#494B4B"
                           VerticalAlignment="Center" Margin="16,0,16,1" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="#4C4C4A" FontFamily="{StaticResource GbpLatin}" Margin="0,0,0,1">
                    <Run Text="Lv." FontSize="16" /><Run Text=" " FontSize="16" /><Run x:Name="txtLevel" FontSize="23" />
                </TextBlock>
            </Grid>
        </Border>

        <Canvas x:Name="rankBadge" Canvas.Left="1154" Canvas.Top="-34" Width="300" Height="300" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
            <Canvas.RenderTransform>
                <ScaleTransform x:Name="rankScale" ScaleX="0.87" ScaleY="0.87" />
            </Canvas.RenderTransform>
        </Canvas>
    </Canvas>
</UserControl>
