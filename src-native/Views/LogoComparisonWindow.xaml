<Window x:Class="BassStation.Views.LogoComparisonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BassStation 2.0 图标设计方案 - 真实 Atelier Z 5弦琴头 + 官方 B"
        Width="1260" Height="720"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        UseLayoutRounding="True"
        FontFamily="Microsoft YaHei UI, Segoe UI, sans-serif"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Grid Margin="36,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Title & Subtitle -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,24">
            <TextBlock Text="BassStation 2.0 图标设计 - 严格对照真实 Atelier Z 5弦琴头比例" FontSize="22" FontWeight="Black" Foreground="#0F172A" HorizontalAlignment="Center" />
            <TextBlock Text="对照 Atelier Z M#265 真实工坊照片 · 琴颈直延 · 琴头双侧对称扩肩 · 经典四上一下(4+1)象耳弦钮 · 官方洋红"
                       FontSize="13" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,5,0,0" />
        </StackPanel>

        <!-- 3 Comparison Columns -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid.Resources>
                <LinearGradientBrush x:Key="BangDreamMagenta" StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF337E" Offset="0" />
                    <GradientStop Color="#E5004F" Offset="0.45" />
                    <GradientStop Color="#C2185B" Offset="1" />
                </LinearGradientBrush>
                <SolidColorBrush x:Key="PureMagenta" Color="#E5004F" />
                <LinearGradientBrush x:Key="StarGold" StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FFF3B0" Offset="0" />
                    <GradientStop Color="#FFD54F" Offset="0.5" />
                    <GradientStop Color="#F59E0B" Offset="1" />
                </LinearGradientBrush>
            </Grid.Resources>

            <!-- ================= OPTION 1: 真实 Atelier Z 5弦工坊比例 + 金星徽章 ================= -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#FF2D75" BorderThickness="1.5" CornerRadius="20" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Viewbox Grid.Row="0" Stretch="Uniform" Margin="16">
                        <Canvas Width="190" Height="240">
                            <Canvas.Effect>
                                <DropShadowEffect Color="#E5004F" BlurRadius="22" ShadowDepth="4" Direction="270" Opacity="0.28" />
                            </Canvas.Effect>

                            <!-- 4 Left Gotoh Cloverleaf Tuners -->
                            <Line X1="70" Y1="58" X2="50" Y2="58" Stroke="{StaticResource BangDreamMagenta}" StrokeThickness="4.5" StrokeStartLineCap="Round" />
                            <Ellipse Canvas.Left="38" Canvas.Top="47" Width="13" Height="13" Fill="{StaticResource BangDreamMagenta}" />
                            <Ellipse Canvas.Left="38" Canvas.Top="57" Width="13" Height="13" Fill="{StaticResource BangDreamMagenta}" />
                            <Ellipse Canvas.Left="34" Canvas.Top="52" Width="12" Height="12" Fill="{StaticResource BangDreamMagenta}" />

                            <Line X1="74" Y1="45" X2="54" Y2="45" Stroke="{StaticResource BangDreamMagenta}" StrokeThickness="4.5" StrokeStartLineCap="Round" />
                            <Ellipse Canvas.Left="42" Canvas.Top="34" Width="13" Height="13" Fill="{StaticResource BangDreamMagenta}" />
                            <Ellipse Canvas.Left="42" Canvas.Top="44" Width="13" Height="13" Fill="{StaticResource BangDreamMagenta}" />
                            <Ellipse Canvas.Left="38" Canvas.Top="39" Width="12" Height="12" Fill="{StaticResource BangDreamMagenta}" />

                            <Line X1="78" Y1="32" X2="58" Y2="32" Stroke="{StaticResource BangDreamMagenta}" StrokeThickness="4.5" StrokeStartLineCap="Round" />
                            <Ellipse Canvas.Left="46" Canvas.Top="21" Width="13" Height="13" Fill="{StaticResource BangDreamMagenta}" />
                            <Ellipse Canvas.Left="46" Canvas.Top="31" Width="13" Height="13" Fill="{StaticResource BangDreamMagenta}" />
                            <Ellipse Canvas.Left="42" Canvas.Top="26" Width="12" Height="12" Fill="{StaticResource BangDreamMagenta}" />

                            <Line X1="82" Y1="19" X2="62" Y2="19" Stroke="{StaticResource BangDreamMagenta}" StrokeThickness="4.5" StrokeStartLineCap="Round" />
                            <Ellipse Canvas.Left="50" Canvas.Top="8" Width="13" Height="13" Fill="{StaticResource BangDreamMagenta}" />
                            <Ellipse Canvas.Left="50" Canvas.Top="18" Width="13" Height="13" Fill="{StaticResource BangDreamMagenta}" />
                            <Ellipse Canvas.Left="46" Canvas.Top="13" Width="12" Height="12" Fill="{StaticResource BangDreamMagenta}" />

                            <!-- 1 Right Gotoh Cloverleaf Tuner (G string) -->
                            <Line X1="112" Y1="52" X2="132" Y2="52" Stroke="{StaticResource BangDreamMagenta}" StrokeThickness="4.5" StrokeStartLineCap="Round" />
                            <Ellipse Canvas.Left="129" Canvas.Top="41" Width="13" Height="13" Fill="{StaticResource BangDreamMagenta}" />
                            <Ellipse Canvas.Left="129" Canvas.Top="51" Width="13" Height="13" Fill="{StaticResource BangDreamMagenta}" />
                            <Ellipse Canvas.Left="134" Canvas.Top="46" Width="12" Height="12" Fill="{StaticResource BangDreamMagenta}" />

                            <!-- Real Atelier Z Headstock + Straight Neck + B Body -->
                            <Path Fill="{StaticResource BangDreamMagenta}">
                                <Path.Data>
                                    F0
                                    M 36,225
                                    L 65,110
                                    L 74,70
                                    L 68,62
                                    L 72,48
                                    L 76,34
                                    L 80,20
                                    L 85,12
                                    C 88,8 92,6 96,6
                                    C 100,6 103,8 105,12
                                    C 104,20 101,30 100,40
                                    C 106,46 112,50 114,54
                                    C 112,60 108,65 106,70
                                    L 97,110
                                    L 138,95
                                    C 152,95 158,105 158,118
                                    C 158,132 150,142 138,146
                                    C 148,150 156,162 156,178
                                    C 156,204 144,225 122,225
                                    L 36,225
                                    Z
                                    <!-- Top Counter Cutout -->
                                    M 95,108
                                    L 108,108
                                    C 114,108 116,112 116,118
                                    C 116,128 112,138 102,138
                                    L 87,138
                                    C 84,138 83,134 85,128
                                    Z
                                    <!-- Bottom Counter Cutout -->
                                    M 82,156
                                    L 98,156
                                    C 107,156 112,164 112,176
                                    C 112,194 104,204 90,204
                                    L 70,204
                                    C 67,204 66,200 68,192
                                    Z
                                </Path.Data>
                            </Path>

                            <!-- Star in the Hollow Notch -->
                            <Polygon Points="124,65 128,75 139,76 131,84 133,94 124,89 115,94 117,84 109,76 120,75"
                                     Fill="{StaticResource StarGold}" Stroke="#FFFFFF" StrokeThickness="1.5" StrokeLineJoin="Round">
                                <Polygon.Effect>
                                    <DropShadowEffect Color="#F59E0B" BlurRadius="8" ShadowDepth="1" Direction="270" Opacity="0.65" />
                                </Polygon.Effect>
                            </Polygon>
                            <Ellipse Canvas.Left="122.5" Canvas.Top="77.5" Width="3" Height="3" Fill="#FFFFFF" />
                        </Canvas>
                    </Viewbox>

                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,12,0,0">
                        <TextBlock Text="方案 1：【Atelier Z 真琴头 + 金星】(强烈推荐)" FontSize="15" FontWeight="Black" Foreground="#FF2D75" HorizontalAlignment="Center" />
                        <TextBlock Text="严格对照M265工坊轮廓 · 真实4+1对称扩肩 · 星辉呼应" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= OPTION 2: 纯粹洋红实心版 ================= -->
            <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="20" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Viewbox Grid.Row="0" Stretch="Uniform" Margin="16">
                        <Canvas Width="190" Height="240">
                            <Canvas.Effect>
                                <DropShadowEffect Color="#E5004F" BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.22" />
                            </Canvas.Effect>

                            <Line X1="70" Y1="58" X2="50" Y2="58" Stroke="{StaticResource PureMagenta}" StrokeThickness="4.5" StrokeStartLineCap="Round" />
                            <Ellipse Canvas.Left="38" Canvas.Top="47" Width="13" Height="13" Fill="{StaticResource PureMagenta}" />
                            <Ellipse Canvas.Left="38" Canvas.Top="57" Width="13" Height="13" Fill="{StaticResource PureMagenta}" />
                            <Ellipse Canvas.Left="34" Canvas.Top="52" Width="12" Height="12" Fill="{StaticResource PureMagenta}" />

                            <Line X1="74" Y1="45" X2="54" Y2="45" Stroke="{StaticResource PureMagenta}" StrokeThickness="4.5" StrokeStartLineCap="Round" />
                            <Ellipse Canvas.Left="42" Canvas.Top="34" Width="13" Height="13" Fill="{StaticResource PureMagenta}" />
                            <Ellipse Canvas.Left="42" Canvas.Top="44" Width="13" Height="13" Fill="{StaticResource PureMagenta}" />
                            <Ellipse Canvas.Left="38" Canvas.Top="39" Width="12" Height="12" Fill="{StaticResource PureMagenta}" />

                            <Line X1="78" Y1="32" X2="58" Y2="32" Stroke="{StaticResource PureMagenta}" StrokeThickness="4.5" StrokeStartLineCap="Round" />
                            <Ellipse Canvas.Left="46" Canvas.Top="21" Width="13" Height="13" Fill="{StaticResource PureMagenta}" />
                            <Ellipse Canvas.Left="46" Canvas.Top="31" Width="13" Height="13" Fill="{StaticResource PureMagenta}" />
                            <Ellipse Canvas.Left="42" Canvas.Top="26" Width="12" Height="12" Fill="{StaticResource PureMagenta}" />

                            <Line X1="82" Y1="19" X2="62" Y2="19" Stroke="{StaticResource PureMagenta}" StrokeThickness="4.5" StrokeStartLineCap="Round" />
                            <Ellipse Canvas.Left="50" Canvas.Top="8" Width="13" Height="13" Fill="{StaticResource PureMagenta}" />
                            <Ellipse Canvas.Left="50" Canvas.Top="18" Width="13" Height="13" Fill="{StaticResource PureMagenta}" />
                            <Ellipse Canvas.Left="46" Canvas.Top="13" Width="12" Height="12" Fill="{StaticResource PureMagenta}" />

                            <Line X1="112" Y1="52" X2="132" Y2="52" Stroke="{StaticResource PureMagenta}" StrokeThickness="4.5" StrokeStartLineCap="Round" />
                            <Ellipse Canvas.Left="129" Canvas.Top="41" Width="13" Height="13" Fill="{StaticResource PureMagenta}" />
                            <Ellipse Canvas.Left="129" Canvas.Top="51" Width="13" Height="13" Fill="{StaticResource PureMagenta}" />
                            <Ellipse Canvas.Left="134" Canvas.Top="46" Width="12" Height="12" Fill="{StaticResource PureMagenta}" />

                            <Path Fill="{StaticResource PureMagenta}">
                                <Path.Data>
                                    F0
                                    M 36,225
                                    L 65,110
                                    L 74,70
                                    L 68,62
                                    L 72,48
                                    L 76,34
                                    L 80,20
                                    L 85,12
                                    C 88,8 92,6 96,6
                                    C 100,6 103,8 105,12
                                    C 104,20 101,30 100,40
                                    C 106,46 112,50 114,54
                                    C 112,60 108,65 106,70
                                    L 97,110
                                    L 138,95
                                    C 152,95 158,105 158,118
                                    C 158,132 150,142 138,146
                                    C 148,150 156,162 156,178
                                    C 156,204 144,225 122,225
                                    L 36,225
                                    Z
                                    M 95,108
                                    L 108,108
                                    C 114,108 116,112 116,118
                                    C 116,128 112,138 102,138
                                    L 87,138
                                    C 84,138 83,134 85,128
                                    Z
                                    M 82,156
                                    L 98,156
                                    C 107,156 112,164 112,176
                                    C 112,194 104,204 90,204
                                    L 70,204
                                    C 67,204 66,200 68,192
                                    Z
                                </Path.Data>
                            </Path>

                            <Polygon Points="124,65 128,75 139,76 131,84 133,94 124,89 115,94 117,84 109,76 120,75"
                                     Fill="{StaticResource PureMagenta}" />
                        </Canvas>
                    </Viewbox>

                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,12,0,0">
                        <TextBlock Text="方案 2：【纯粹洋红一体标】" FontSize="15" FontWeight="Black" Foreground="#0F172A" HorizontalAlignment="Center" />
                        <TextBlock Text="全件洋红统一色调 · 浑然天成 · 极简专业" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= OPTION 3: 纯粹无星剪影版 ================= -->
            <Border Grid.Column="4" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="20" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Viewbox Grid.Row="0" Stretch="Uniform" Margin="16">
                        <Canvas Width="190" Height="240">
                            <Canvas.Effect>
                                <DropShadowEffect Color="#E5004F" BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.22" />
                            </Canvas.Effect>

                            <Line X1="70" Y1="58" X2="50" Y2="58" Stroke="{StaticResource BangDreamMagenta}" StrokeThickness="4.5" StrokeStartLineCap="Round" />
                            <Ellipse Canvas.Left="38" Canvas.Top="47" Width="13" Height="13" Fill="{StaticResource BangDreamMagenta}" />
                            <Ellipse Canvas.Left="38" Canvas.Top="57" Width="13" Height="13" Fill="{StaticResource BangDreamMagenta}" />
                            <Ellipse Canvas.Left="34" Canvas.Top="52" Width="12" Height="12" Fill="{StaticResource BangDreamMagenta}" />

                            <Line X1="74" Y1="45" X2="54" Y2="45" Stroke="{StaticResource BangDreamMagenta}" StrokeThickness="4.5" StrokeStartLineCap="Round" />
                            <Ellipse Canvas.Left="42" Canvas.Top="34" Width="13" Height="13" Fill="{StaticResource BangDreamMagenta}" />
                            <Ellipse Canvas.Left="42" Canvas.Top="44" Width="13" Height="13" Fill="{StaticResource BangDreamMagenta}" />
                            <Ellipse Canvas.Left="38" Canvas.Top="39" Width="12" Height="12" Fill="{StaticResource BangDreamMagenta}" />

                            <Line X1="78" Y1="32" X2="58" Y2="32" Stroke="{StaticResource BangDreamMagenta}" StrokeThickness="4.5" StrokeStartLineCap="Round" />
                            <Ellipse Canvas.Left="46" Canvas.Top="21" Width="13" Height="13" Fill="{StaticResource BangDreamMagenta}" />
                            <Ellipse Canvas.Left="46" Canvas.Top="31" Width="13" Height="13" Fill="{StaticResource BangDreamMagenta}" />
                            <Ellipse Canvas.Left="42" Canvas.Top="26" Width="12" Height="12" Fill="{StaticResource BangDreamMagenta}" />

                            <Line X1="82" Y1="19" X2="62" Y2="19" Stroke="{StaticResource BangDreamMagenta}" StrokeThickness="4.5" StrokeStartLineCap="Round" />
                            <Ellipse Canvas.Left="50" Canvas.Top="8" Width="13" Height="13" Fill="{StaticResource BangDreamMagenta}" />
                            <Ellipse Canvas.Left="50" Canvas.Top="18" Width="13" Height="13" Fill="{StaticResource BangDreamMagenta}" />
                            <Ellipse Canvas.Left="46" Canvas.Top="13" Width="12" Height="12" Fill="{StaticResource BangDreamMagenta}" />

                            <Line X1="112" Y1="52" X2="132" Y2="52" Stroke="{StaticResource BangDreamMagenta}" StrokeThickness="4.5" StrokeStartLineCap="Round" />
                            <Ellipse Canvas.Left="129" Canvas.Top="41" Width="13" Height="13" Fill="{StaticResource BangDreamMagenta}" />
                            <Ellipse Canvas.Left="129" Canvas.Top="51" Width="13" Height="13" Fill="{StaticResource BangDreamMagenta}" />
                            <Ellipse Canvas.Left="134" Canvas.Top="46" Width="12" Height="12" Fill="{StaticResource BangDreamMagenta}" />

                            <Path Fill="{StaticResource BangDreamMagenta}">
                                <Path.Data>
                                    F0
                                    M 36,225
                                    L 65,110
                                    L 74,70
                                    L 68,62
                                    L 72,48
                                    L 76,34
                                    L 80,20
                                    L 85,12
                                    C 88,8 92,6 96,6
                                    C 100,6 103,8 105,12
                                    C 104,20 101,30 100,40
                                    C 106,46 112,50 114,54
                                    C 112,60 108,65 106,70
                                    L 97,110
                                    L 138,95
                                    C 152,95 158,105 158,118
                                    C 158,132 150,142 138,146
                                    C 148,150 156,162 156,178
                                    C 156,204 144,225 122,225
                                    L 36,225
                                    Z
                                    M 95,108
                                    L 108,108
                                    C 114,108 116,112 116,118
                                    C 116,128 112,138 102,138
                                    L 87,138
                                    C 84,138 83,134 85,128
                                    Z
                                    M 82,156
                                    L 98,156
                                    C 107,156 112,164 112,176
                                    C 112,194 104,204 90,204
                                    L 70,204
                                    C 67,204 66,200 68,192
                                    Z
                                </Path.Data>
                            </Path>

                            <Path Data="M 36,224 L 74,70" Stroke="#FFFFFF" StrokeThickness="2.2" Opacity="0.35" StrokeStartLineCap="Round" />
                        </Canvas>
                    </Viewbox>

                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,12,0,0">
                        <TextBlock Text="方案 3：【纯粹极简琴身轮廓】" FontSize="15" FontWeight="Black" Foreground="#0F172A" HorizontalAlignment="Center" />
                        <TextBlock Text="无星纯粹剪影 · 微光脊柱导角 · 极致耐看" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
