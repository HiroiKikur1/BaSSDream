<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="po">
    <!-- The one palette. XAML refers to these names; C# goes through Services/Palette.cs.
         Brand = the logo's own magenta. Judgment colours (PERFECT…MISS) live with the report, not here. -->

    <Color x:Key="BrandColor">#E50050</Color>
    <Color x:Key="BrandLightColor">#FF4D8A</Color>
    <Color x:Key="BrandLipColor">#A8003B</Color>
    <Color x:Key="BrandPaleColor">#FFE8F0</Color>

    <Color x:Key="InkColor">#3D3A4B</Color>
    <Color x:Key="TextColor">#4A4750</Color>
    <Color x:Key="SubColor">#7C7688</Color>
    <Color x:Key="MutedColor">#B3ACBC</Color>
    <Color x:Key="GhostColor">#CFCBD1</Color>
    <Color x:Key="LineColor">#F1DCE5</Color>
    <Color x:Key="FrameColor">#D9D6DC</Color>
    <Color x:Key="FrameSoftColor">#E4DCE2</Color>
    <Color x:Key="WhiteColor">#FFFFFF</Color>
    <Color x:Key="StageColor">#FFF7FA</Color>
    <Color x:Key="WashColor">#FFF1F5</Color>

    <Color x:Key="EasyColor">#3E8BFF</Color>
    <Color x:Key="NormalColor">#34C274</Color>
    <Color x:Key="HardColor">#FFAE1A</Color>
    <Color x:Key="ExpertColor">#FF4058</Color>
    <Color x:Key="SpecialColor">#E04BD6</Color>

    <SolidColorBrush x:Key="BrandBrush" Color="{StaticResource BrandColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="BrandLightBrush" Color="{StaticResource BrandLightColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="BrandLipBrush" Color="{StaticResource BrandLipColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="BrandPaleBrush" Color="{StaticResource BrandPaleColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="SubBrush" Color="{StaticResource SubColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="GhostBrush" Color="{StaticResource GhostColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="FrameBrush" Color="{StaticResource FrameColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="FrameSoftBrush" Color="{StaticResource FrameSoftColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource WhiteColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="StageBrush" Color="{StaticResource StageColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="WashBrush" Color="{StaticResource WashColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="EasyBrush" Color="{StaticResource EasyColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="NormalBrush" Color="{StaticResource NormalColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="HardBrush" Color="{StaticResource HardColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="ExpertBrush" Color="{StaticResource ExpertColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="SpecialBrush" Color="{StaticResource SpecialColor}" po:Freeze="True" />
</ResourceDictionary>
